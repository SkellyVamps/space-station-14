<Control xmlns="https://spacestation14.io"
         xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
            <BoxContainer Orientation="Vertical" Margin="8 8 8 8">
                <Label Text="{Loc 'ui-options-voice-header'}" StyleClasses="LabelKeyText" />
                <Label Name="StatusLabel" StyleClasses="LabelSubText" Margin="0 0 0 6" />
                <Label Name="TranscribeNotice" Text="{Loc 'ui-options-voice-transcribe-notice'}" StyleClasses="LabelSubText"
                       Margin="0 0 0 6" Visible="False" />
                <CheckBox Name="EnabledCheckBox" Text="{Loc 'ui-options-voice-enabled'}" />

                <BoxContainer Name="ExternalSection" Orientation="Vertical" Visible="False">
                    <Label Text="{Loc 'ui-options-voice-external-header'}" StyleClasses="LabelKeyText" Margin="0 10 0 0" />
                    <Label Name="ExternalStatus" StyleClasses="LabelSubText" />
                    <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                        <Button Name="ExternalOpenButton" Text="{Loc 'ui-options-voice-external-open'}"
                                ToolTip="{Loc 'ui-options-voice-external-open-tooltip'}" />
                        <Button Name="ExternalCopyButton" Text="{Loc 'ui-options-voice-external-copy'}"
                                ToolTip="{Loc 'ui-options-voice-external-copy-tooltip'}" Margin="4 0 0 0" />
                        <Button Name="ExternalDisconnectButton" Text="{Loc 'ui-options-voice-external-disconnect'}"
                                Margin="4 0 0 0" />
                    </BoxContainer>
                </BoxContainer>

                <Label Text="{Loc 'ui-options-voice-input-header'}" StyleClasses="LabelKeyText" Margin="0 10 0 0" />
                <ui:OptionDropDown Name="DropDownInputDevice" Title="{Loc 'ui-options-voice-input-device'}" />
                <ui:OptionSlider Name="SliderInputGain" Title="{Loc 'ui-options-voice-input-gain'}" />
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 4">
                    <Label Text="{Loc 'ui-options-voice-level'}" MinWidth="160" />
                    <ProgressBar Name="LevelMeter" MinValue="-80" MaxValue="0" Value="-80"
                                 HorizontalExpand="True" MinHeight="14" />
                    <Label Name="LevelLabel" MinWidth="70" Align="Right" />
                </BoxContainer>
                <Button Name="MicTestButton" ToggleMode="True" Text="{Loc 'ui-options-voice-mic-test'}"
                        ToolTip="{Loc 'ui-options-voice-mic-test-tooltip'}" HorizontalAlignment="Left" />

                <Label Text="{Loc 'ui-options-voice-transmit-header'}" StyleClasses="LabelKeyText" Margin="0 10 0 0" />
                <ui:OptionDropDown Name="DropDownInputMode" Title="{Loc 'ui-options-voice-input-mode'}" />
                <Label Name="PushToTalkHint" StyleClasses="LabelSubText" />
                <ui:OptionSlider Name="SliderActivationThreshold" Title="{Loc 'ui-options-voice-activation-threshold'}" />
                <ui:OptionSlider Name="SliderActivationRelease" Title="{Loc 'ui-options-voice-activation-release'}" />
                <ui:OptionSlider Name="SliderNoiseGate" Title="{Loc 'ui-options-voice-noise-gate'}" />
                <ui:OptionSlider Name="SliderNoiseSuppression" Title="{Loc 'ui-options-voice-noise-suppression'}" />
                <Label Text="{Loc 'ui-options-voice-noise-suppression-hint'}" StyleClasses="LabelSubText" />

                <Label Text="{Loc 'ui-options-voice-radio-keys-header'}" StyleClasses="LabelKeyText" Margin="0 10 0 0" />
                <Label Text="{Loc 'ui-options-voice-radio-keys-hint'}" StyleClasses="LabelSubText" />
                <ui:OptionDropDown Name="DropDownRadioKey2" Title="{Loc 'ui-options-voice-radio-key2'}" />
                <ui:OptionDropDown Name="DropDownRadioKey3" Title="{Loc 'ui-options-voice-radio-key3'}" />
                <ui:OptionDropDown Name="DropDownRadioKey4" Title="{Loc 'ui-options-voice-radio-key4'}" />

                <Label Text="{Loc 'ui-options-voice-output-header'}" StyleClasses="LabelKeyText" Margin="0 10 0 0" />
                <ui:OptionSlider Name="SliderOutputVolume" Title="{Loc 'ui-options-voice-output-volume'}" />
                <ui:OptionSlider Name="SliderRadioVolume" Title="{Loc 'ui-options-voice-radio-volume'}" />
                <ui:OptionSlider Name="SliderJitterBuffer" Title="{Loc 'ui-options-voice-jitter-buffer'}" />
                <ui:OptionSlider Name="SliderDucking" Title="{Loc 'ui-options-voice-ducking'}" />
                <CheckBox Name="IndicatorsCheckBox" Text="{Loc 'ui-options-voice-indicators'}" />
                <CheckBox Name="RangeCircleCheckBox" Text="{Loc 'ui-options-voice-range-circle'}" />
                <BoxContainer Orientation="Horizontal">
                    <CheckBox Name="RadioPanelCheckBox" Text="{Loc 'ui-options-voice-radio-panel'}" />
                    <Button Name="RadioPanelResetButton" Text="{Loc 'ui-options-voice-radio-panel-reset'}"
                            Margin="10 0 0 0" />
                </BoxContainer>
                <Label Text="{Loc 'ui-options-voice-mute-hint'}" StyleClasses="LabelSubText" Margin="0 6 0 0" />
            </BoxContainer>
        </ScrollContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</Control>
