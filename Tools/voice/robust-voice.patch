diff --git a/Robust.Client/Audio/VoiceCodec.cs b/Robust.Client/Audio/VoiceCodec.cs
new file mode 100644
index 000000000..e349ecafb
--- /dev/null
+++ b/Robust.Client/Audio/VoiceCodec.cs
@@ -0,0 +1,50 @@
+using System;
+using Concentus.Enums;
+using Concentus.Structs;
+
+namespace Robust.Client.Audio;
+
+/// <summary>48 kHz mono, 20 ms managed Opus. Keeps codec implementation outside content sandbox.</summary>
+public sealed class VoiceEncoder
+{
+#pragma warning disable CS0618 // Deliberately choose managed implementation; no native library probing.
+    private readonly OpusEncoder _encoder = new(48000, 1, OpusApplication.OPUS_APPLICATION_VOIP)
+    {
+        Bitrate = 24000,
+        Complexity = 5,
+        UseInbandFEC = false,
+        UseDTX = false,
+    };
+#pragma warning restore CS0618
+
+    public int Encode(ReadOnlySpan<short> pcm, Span<byte> encoded)
+    {
+        if (pcm.Length != 960 || encoded.Length < 512)
+            throw new ArgumentException("Voice requires 960 PCM samples and 512 output bytes");
+        return _encoder.Encode(pcm, 960, encoded, 512);
+    }
+}
+
+/// <summary>One decoder per authenticated speaker. Empty input invokes Opus packet loss concealment.</summary>
+public sealed class VoiceDecoder
+{
+#pragma warning disable CS0618
+    private readonly OpusDecoder _decoder = new(48000, 1);
+#pragma warning restore CS0618
+
+    public int Decode(ReadOnlySpan<byte> encoded, Span<float> pcm)
+    {
+        if (encoded.Length > 512 || pcm.Length != 960)
+            return 0;
+        try
+        {
+            return _decoder.Decode(encoded, pcm, 960);
+        }
+        catch (Exception)
+        {
+            pcm.Clear();
+            _decoder.ResetState();
+            return 0;
+        }
+    }
+}
