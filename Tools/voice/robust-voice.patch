diff --git a/Robust.Client/Audio/AudioManager.Capture.cs b/Robust.Client/Audio/AudioManager.Capture.cs
new file mode 100644
index 000000000..461a42d67
--- /dev/null
+++ b/Robust.Client/Audio/AudioManager.Capture.cs
@@ -0,0 +1,81 @@
+using System;
+using System.Collections.Generic;
+using OpenTK.Audio.OpenAL;
+
+namespace Robust.Client.Audio;
+
+internal sealed partial class AudioManager
+{
+    public IReadOnlyList<string> GetCaptureDevices()
+    {
+        try
+        {
+            return ALC.GetString((AlcGetStringList) 0x310);
+        }
+        catch (Exception e)
+        {
+            OpenALSawmill.Warning($"Microphone enumeration failed: {e.Message}");
+            return Array.Empty<string>();
+        }
+    }
+
+    public IAudioCapture? OpenCapture(string? device)
+    {
+        try
+        {
+            var handle = ALC.CaptureOpenDevice(device!, 48000, ALFormat.Mono16, 4800);
+            if (handle == ALCaptureDevice.Null)
+                return null;
+            try
+            {
+                ALC.CaptureStart(handle);
+                return new OpenAlCapture(handle);
+            }
+            catch
+            {
+                ALC.CaptureCloseDevice(handle);
+                throw;
+            }
+        }
+        catch (Exception e)
+        {
+            OpenALSawmill.Warning($"Microphone open failed: {e.Message}");
+            return null;
+        }
+    }
+
+    private sealed class OpenAlCapture(ALCaptureDevice handle) : IAudioCapture
+    {
+        private ALCaptureDevice _handle = handle;
+        public int AvailableSamples
+        {
+            get
+            {
+                if (_handle == ALCaptureDevice.Null) return 0;
+                var samples = ALC.GetInteger(_handle, (AlcGetInteger) 0x312);
+                if (ALC.GetError(new ALDevice(_handle.Handle)) != AlcError.NoError)
+                    throw new InvalidOperationException("Microphone disconnected or capture failed");
+                return Math.Max(0, samples);
+            }
+        }
+
+        public unsafe int Read(Span<short> destination)
+        {
+            var count = Math.Min(destination.Length, AvailableSamples);
+            if (count == 0)
+                return 0;
+            fixed (short* data = destination)
+                ALC.CaptureSamples(_handle, data, count);
+            return count;
+        }
+
+        public void Dispose()
+        {
+            if (_handle == ALCaptureDevice.Null)
+                return;
+            ALC.CaptureStop(_handle);
+            ALC.CaptureCloseDevice(_handle);
+            _handle = ALCaptureDevice.Null;
+        }
+    }
+}
