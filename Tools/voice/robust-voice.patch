+namespace Robust.Client.Audio;
+
+/// <summary>Game-thread-only microphone handle. Dispose closes the device and discards queued audio.</summary>
+public interface IAudioCapture : IDisposable
+{
+    int AvailableSamples { get; }
+    /// <summary>Reads available mono 48 kHz PCM. Returns zero after failure or disposal.</summary>
+    int Read(Span<short> destination);
+}
