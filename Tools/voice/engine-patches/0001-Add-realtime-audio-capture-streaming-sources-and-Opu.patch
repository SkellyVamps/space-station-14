new file mode 100644
index 000000000..fcbc5480e
--- /dev/null
+++ b/Robust.Shared/Audio/Codecs/OpusPacket.cs
@@ -0,0 +1,85 @@
+using System;
+
+namespace Robust.Shared.Audio.Codecs;
+
+/// <summary>
+/// Cheap structural inspection of Opus packets (RFC 6716 section 3) without decoding them.
+/// Lets a server sanity-check relayed packets without running a decoder.
+/// </summary>
+public static class OpusPacket
+{
+    /// <summary>
+    /// Longest duration a single Opus packet may encode, in milliseconds.
+    /// </summary>
+    public const int MaxPacketDurationMs = 120;
+
+    /// <summary>
+    /// Returns the number of samples per channel the packet decodes to at <paramref name="sampleRate"/>,
+    /// or -1 if the packet is structurally invalid.
+    /// </summary>
+    public static int GetSampleCount(ReadOnlySpan<byte> packet, int sampleRate)
+    {
+        if (packet.Length < 1 || sampleRate <= 0)
+            return -1;
+
+        var toc = packet[0];
+        int frames;
+
+        switch (toc & 0x3)
+        {
+            case 0:
+                frames = 1;
+                break;
+            case 1:
+            case 2:
+                frames = 2;
+                break;
+            default:
+                if (packet.Length < 2)
+                    return -1;
+
+                frames = packet[1] & 0x3F;
+                if (frames == 0)
+                    return -1;
+                break;
+        }
+
+        // Frame duration in units of 1/400 s (2.5 ms).
+        var frameUnits = GetFrameDurationUnits(toc);
+        var totalUnits = frames * frameUnits;
+
+        if (totalUnits * 25 > MaxPacketDurationMs * 10)
+            return -1;
+
+        return totalUnits * sampleRate / 400;
+    }
+
+    /// <summary>
+    /// Frame duration encoded in the TOC byte, in units of 2.5 ms.
+    /// </summary>
+    private static int GetFrameDurationUnits(byte toc)
+    {
+        var config = toc >> 3;
+
+        if (config < 12)
+        {
+            // SILK-only: 10, 20, 40, 60 ms
+            return (config & 0x3) switch
+            {
+                0 => 4,
+                1 => 8,
+                2 => 16,
+                _ => 24,
+            };
+        }
+
+        if (config < 16)
+        {
+            // Hybrid: 10, 20 ms
+            return (config & 0x1) == 0 ? 4 : 8;
+        }
+
+        // CELT-only: 2.5, 5, 10, 20 ms
+        return 1 << (config & 0x3);
+    }
+}
diff --git a/Robust.Shared/Audio/Codecs/OpusVoiceDecoder.cs b/Robust.Shared/Audio/Codecs/OpusVoiceDecoder.cs
new file mode 100644
index 000000000..4d990cfdb
--- /dev/null
+++ b/Robust.Shared/Audio/Codecs/OpusVoiceDecoder.cs
@@ -0,0 +1,72 @@
+using System;
+using Concentus;
+
+namespace Robust.Shared.Audio.Codecs;
+
+/// <summary>
+/// Mono Opus decoder with packet loss concealment. Not thread safe.
+/// </summary>
+public sealed class OpusVoiceDecoder
+{
+    private readonly IOpusDecoder _decoder;
+
+    public int SampleRate { get; }
+
+    /// <param name="sampleRate">One of 8000, 12000, 16000, 24000 or 48000.</param>
+    public OpusVoiceDecoder(int sampleRate)
+    {
+        SampleRate = sampleRate;
+        _decoder = OpusCodecFactory.CreateDecoder(sampleRate, 1);
+    }
+
+    /// <summary>
+    /// Decodes a packet into <paramref name="output"/>.
+    /// </summary>
+    /// <param name="packet">The packet. Malformed packets are rejected rather than throwing.</param>
+    /// <param name="output">Destination. Its length is the maximum frame size accepted.</param>
+    /// <param name="decodeFec">
+    /// Decode the forward error correction data embedded in <paramref name="packet"/>, which reconstructs the frame
+    /// <i>before</i> it. Use when that previous packet was lost; <paramref name="output"/> must then be exactly one
+    /// frame long.
+    /// </param>
+    /// <returns>Samples decoded, or -1 if the packet was invalid.</returns>
+    public int Decode(ReadOnlySpan<byte> packet, Span<short> output, bool decodeFec = false)
+    {
+        if (packet.Length == 0)
+            return -1;
+
+        if (OpusPacket.GetSampleCount(packet, SampleRate) is var count && (count < 0 || count > output.Length))
+            return -1;
+
+        try
+        {
+            return _decoder.Decode(packet, output, output.Length, decodeFec);
+        }
+        catch (Exception)
+        {
+            return -1;
+        }
+    }
+
+    /// <summary>
+    /// Synthesizes a concealment frame for a packet that never arrived.
+    /// </summary>
+    /// <param name="output">Destination, must be exactly the length of the missing frame.</param>
+    /// <returns>Samples generated, or -1 on failure.</returns>
+    public int DecodeLost(Span<short> output)
+    {
+        try
+        {
+            return _decoder.Decode(ReadOnlySpan<byte>.Empty, output, output.Length, false);
+        }
+        catch (Exception)
+        {
+            return -1;
+        }
+    }
+
+    public void Reset()
+    {
+        _decoder.ResetState();
+    }
+}
diff --git a/Robust.Shared/Audio/Codecs/OpusVoiceEncoder.cs b/Robust.Shared/Audio/Codecs/OpusVoiceEncoder.cs
new file mode 100644
index 000000000..ae6a7af36
--- /dev/null
+++ b/Robust.Shared/Audio/Codecs/OpusVoiceEncoder.cs
@@ -0,0 +1,90 @@
+using System;
+using Concentus;
+using Concentus.Enums;
+
+namespace Robust.Shared.Audio.Codecs;
+
+/// <summary>
+/// Mono Opus encoder tuned for voice. Not thread safe.
+/// </summary>
+public sealed class OpusVoiceEncoder
+{
+    private readonly IOpusEncoder _encoder;
+
+    public int SampleRate { get; }
+
+    /// <param name="sampleRate">One of 8000, 12000, 16000, 24000 or 48000.</param>
+    public OpusVoiceEncoder(int sampleRate)
+    {
+        SampleRate = sampleRate;
+        _encoder = OpusCodecFactory.CreateEncoder(sampleRate, 1, OpusApplication.OPUS_APPLICATION_VOIP);
+        _encoder.SignalType = OpusSignal.OPUS_SIGNAL_VOICE;
+        _encoder.UseVBR = true;
+    }
+
+    /// <summary>
+    /// Target bitrate in bits per second.
+    /// </summary>
+    public int Bitrate
+    {
+        get => _encoder.Bitrate;
+        set => _encoder.Bitrate = Math.Clamp(value, 6000, 128000);
+    }
+
+    /// <summary>
+    /// Encoder complexity, 0 (fastest) to 10 (best quality).
+    /// </summary>
+    public int Complexity
+    {
+        get => _encoder.Complexity;
+        set => _encoder.Complexity = Math.Clamp(value, 0, 10);
+    }
+
+    /// <summary>
+    /// Embeds redundant data for the previous frame so receivers can recover single lost packets.
+    /// </summary>
+    public bool UseInbandFec
+    {
+        get => _encoder.UseInbandFEC;
+        set => _encoder.UseInbandFEC = value;
+    }
+
+    /// <summary>
+    /// Expected packet loss in percent; higher values make FEC more aggressive.
+    /// </summary>
+    public int ExpectedPacketLossPercent
+    {
+        get => _encoder.PacketLossPercent;
+        set => _encoder.PacketLossPercent = Math.Clamp(value, 0, 100);
+    }
+
+    /// <summary>
+    /// Discontinuous transmission: emit tiny packets during silence.
+    /// </summary>
+    public bool UseDtx
+    {
+        get => _encoder.UseDTX;
+        set => _encoder.UseDTX = value;
+    }
+
+    /// <summary>
+    /// Encodes one frame. <paramref name="pcm"/> must be exactly 2.5, 5, 10, 20, 40 or 60 ms long.
+    /// </summary>
+    /// <returns>Number of bytes written to <paramref name="output"/>, or -1 on failure.</returns>
+    public int Encode(ReadOnlySpan<short> pcm, Span<byte> output)
+    {
+        try
+        {
+            return _encoder.Encode(pcm, pcm.Length, output, output.Length);
+        }
+        catch (Exception)
+        {
+            return -1;
+        }
+    }
+
+    public void Reset()
+    {
+        _encoder.ResetState();
+    }
+}
