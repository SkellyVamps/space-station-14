<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>SkellyLauncher</AssemblyName><ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.2.4" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="11.2.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <EmbeddedResource Include="update-trust.json" LogicalName="UpdateTrust" />
  </ItemGroup>
</Project>
